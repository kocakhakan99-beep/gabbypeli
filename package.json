{
  "name": "gabbypeli",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-styles.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "npm run build && python3 -m http.server 8000 --bind 127.0.0.1",
    "test": "npm run build && node --test tests/*.test.js",
    "test:browser": "playwright test",
    "audio:plan": "node scripts/generate-narration.mjs --dry-run",
    "audio:generate": "node scripts/generate-narration.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "5.9.3",
    "prettier": "3.6.2"
  }
}
